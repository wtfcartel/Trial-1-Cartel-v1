// Ad Hoc Nursing marketplace — data model
// Dev uses SQLite for zero-setup local running; swap the datasource to
// Postgres for production (see README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  FACILITY_ADMIN
  NURSE
  ADMIN
}

enum ShiftStatus {
  OPEN
  FILLED
  CANCELLED
  COMPLETED
}

enum ClaimStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Facility {
  id        String   @id @default(cuid())
  name      String
  address   String
  createdAt DateTime @default(now())

  admins User[]
  shifts Shift[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id])

  nurseProfile NurseProfile?
  claims       ShiftClaim[]
}

model NurseProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
  registrationNo String
  qualifications String
  bio            String?

  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?

  certificates Certificate[]
  induction    InductionProgress[]
  availability AvailabilityBlock[]
}

model Certificate {
  id             String       @id @default(cuid())
  nurseProfileId String
  nurseProfile   NurseProfile @relation(fields: [nurseProfileId], references: [id])
  label          String
  fileName       String
  storedPath     String
  mimeType       String
  uploadedAt     DateTime     @default(now())
}

model InductionModule {
  id          String @id @default(cuid())
  title       String
  description String
  order       Int    @default(0)

  progress InductionProgress[]
}

model InductionProgress {
  id             String          @id @default(cuid())
  nurseProfileId String
  nurseProfile   NurseProfile    @relation(fields: [nurseProfileId], references: [id])
  moduleId       String
  module         InductionModule @relation(fields: [moduleId], references: [id])
  completedAt    DateTime        @default(now())

  @@unique([nurseProfileId, moduleId])
}

model AvailabilityBlock {
  id             String       @id @default(cuid())
  nurseProfileId String
  nurseProfile   NurseProfile @relation(fields: [nurseProfileId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  note           String?
  createdAt      DateTime     @default(now())
}

model Shift {
  id                    String      @id @default(cuid())
  facilityId            String
  facility              Facility    @relation(fields: [facilityId], references: [id])
  title                 String
  ward                  String
  startsAt              DateTime
  endsAt                DateTime
  requiredQualification String
  hourlyRateCents       Int
  notes                 String?
  // Non-identifying handover/care details for the confirmed nurse only —
  // see README for why this must not carry patient-identifiable health info.
  careNotes             String?
  status                ShiftStatus @default(OPEN)
  createdAt             DateTime    @default(now())

  claims ShiftClaim[]
}

model ShiftClaim {
  id        String      @id @default(cuid())
  shiftId   String
  shift     Shift       @relation(fields: [shiftId], references: [id])
  nurseId   String
  nurse     User        @relation(fields: [nurseId], references: [id])
  status    ClaimStatus @default(REQUESTED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([shiftId, nurseId])
}
